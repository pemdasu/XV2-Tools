<mvvm:AutoObservableWindow x:Class="EEPK_Organiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:EEPK_Organiser.View"
        xmlns:eepk="clr-namespace:Xv2CoreLib.EEPK;assembly=Xv2CoreLib"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:undoRedo="clr-namespace:Xv2CoreLib.Resource.UndoRedo;assembly=Xv2CoreLib"
        xmlns:mvvm="clr-namespace:LB_Common.Mvvm;assembly=LB_Common"
        xmlns:forms="clr-namespace:EEPK_Organiser.Forms"
        mc:Ignorable="d"
        xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
        Dialog:DialogParticipation.Register="{Binding}"
        Title="EEPK Organiser" TitleCharacterCasing="Normal" MinHeight="400" MinWidth="850" Height="700" Width="1280" ResizeMode="CanResizeWithGrip" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" Name="Window">
    <mvvm:AutoObservableWindow.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl"  Command="{Binding Source={x:Static undoRedo:UndoManager.Instance}, Path=UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl"  Command="{Binding Source={x:Static undoRedo:UndoManager.Instance}, Path=RedoCommand}"/>
    </mvvm:AutoObservableWindow.InputBindings>
    <mvvm:AutoObservableWindow.Resources>
        <ObjectDataProvider x:Key="PlacementEnum" MethodName="GetValues"
                        ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="eepk:EffectPart+Attachment"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="DeactivationModeEnum" MethodName="GetValues"
                        ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="eepk:EffectPart+DeactivationMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

    </mvvm:AutoObservableWindow.Resources>

    <Grid AllowDrop="True" Drop="Grid_FilesDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Margin="0, 2" HorizontalAlignment="Left" FontSize="12" FocusManager.IsFocusScope="False">
            <MenuItem Header="File">
                <MenuItem Header="New" Command="{Binding ElementName=Window, Path=MenuNewCommand}"/>
                <MenuItem Header="Open" Command="{Binding ElementName=Window, Path=MenuOpenCommand}"/>
                <MenuItem Header="Save" Command="{Binding ElementName=Window, Path=MenuSaveCommand}"/>
                <MenuItem Header="Save As.." Command="{Binding ElementName=Window, Path=MenuSaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="Load From Game" IsEnabled="{Binding ElementName=Window, Path=CanLoadFromGame}">
                    <MenuItem Header="CMN" Command="{Binding ElementName=Window, Path=MenuLoadFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.CMN}"/>
                    <MenuItem Header="Character" Command="{Binding ElementName=Window, Path=MenuLoadFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Character}"/>
                    <MenuItem Header="Super Skill" Command="{Binding ElementName=Window, Path=MenuLoadFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.SuperSkill}"/>
                    <MenuItem Header="Ultimate Skill" Command="{Binding ElementName=Window, Path=MenuLoadFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.UltimateSkill}"/>
                    <MenuItem Header="Evasive Skill" Command="{Binding ElementName=Window, Path=MenuLoadFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.EvasiveSkill}"/>
                    <MenuItem Header="Blast Skill" Command="{Binding ElementName=Window, Path=MenuLoadFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.BlastSkill}"/>
                    <MenuItem Header="Awoken Skill" Command="{Binding ElementName=Window, Path=MenuLoadFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.AwokenSkill}"/>
                    <MenuItem Header="Demo (Cutscenes)" Command="{Binding ElementName=Window, Path=MenuLoadFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Demo}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Version" IsEnabled="{Binding ElementName=Window, Path=IsFileLoaded}">
                    <MenuItem IsChecked="{Binding ElementName=Window, Path=IsVerDBXV2, UpdateSourceTrigger=PropertyChanged}" IsCheckable="True" Header="DRAGON BALL XENOVERSE 2"/>
                    <MenuItem IsChecked="{Binding ElementName=Window, Path=IsVerSDBH, UpdateSourceTrigger=PropertyChanged}" IsCheckable="True" Header="SDBH / DB BREAKERS"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Settings" Command="{Binding ElementName=Window, Path=MenuSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Exit" Command="{Binding ElementName=Window, Path=MenuExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="{Binding Source={x:Static undoRedo:UndoManager.Instance}, Path=UndoDescription}" Command="{Binding Source={x:Static undoRedo:UndoManager.Instance}, Path=UndoCommand}"/>
                <MenuItem Header="{Binding Source={x:Static undoRedo:UndoManager.Instance}, Path=RedoDescription}" Command="{Binding Source={x:Static undoRedo:UndoManager.Instance}, Path=RedoCommand}"/>
            </MenuItem>
            <MenuItem Header="Import" IsEnabled="{Binding ElementName=Window, Path=IsFileLoaded}">
                <MenuItem Header="Import Effect(s)">
                    <MenuItem Header="Load External EEPK" Command="{Binding ElementName=Window, Path=EepkView.ImportEffectsFromFileCommand}"/>
                    <Separator/>
                    <MenuItem Header="CMN" Command="{Binding ElementName=Window, Path=EepkView.ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.CMN}"/>
                    <MenuItem Header="Character" Command="{Binding ElementName=Window, Path=EepkView.ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Character}"/>
                    <MenuItem Header="Super Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.SuperSkill}"/>
                    <MenuItem Header="Ultimate Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.UltimateSkill}"/>
                    <MenuItem Header="Evasive Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.EvasiveSkill}"/>
                    <MenuItem Header="Blast Skill/Type" Command="{Binding ElementName=Window, Path=EepkView.ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.BlastSkill}"/>
                    <MenuItem Header="Awoken Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.AwokenSkill}"/>
                    <MenuItem Header="Demo (Cutscene)" Command="{Binding ElementName=Window, Path=EepkView.ImportEffectsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Demo}"/>
                    <Separator/>
                    <MenuItem Header="From Cached Files" ItemsSource="{Binding cacheManager.CachedFiles, ElementName=eepkEditor}" Click="EffectOptions_ImportEffectsFromCache_Click">
                        <MenuItem.ItemContainerStyle>
                            <Style>
                                <Setter Property="MenuItem.Header" Value="{Binding DisplayName}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Import Asset(s)" IsEnabled="{Binding ElementName=Window, Path=IsFileLoaded}">
                    <MenuItem Header="PBIND">
                        <MenuItem Header="Load External EEPK" Command="{Binding ElementName=Window, Path=EepkView.ImportAssetsFromExternalFileCommand}" CommandParameter="{x:Static eepk:AssetType.PBIND}"/>
                        <Separator/>
                        <MenuItem Header="CMN" Command="{Binding ElementName=Window, Path=EepkView.ImportPbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.CMN}"/>
                        <MenuItem Header="Character" Command="{Binding ElementName=Window, Path=EepkView.ImportPbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Character}"/>
                        <MenuItem Header="Super Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportPbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.SuperSkill}"/>
                        <MenuItem Header="Ultimate Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportPbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.UltimateSkill}"/>
                        <MenuItem Header="Evasive Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportPbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.EvasiveSkill}"/>
                        <MenuItem Header="Blast Skill/Type" Command="{Binding ElementName=Window, Path=EepkView.ImportPbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.BlastSkill}"/>
                        <MenuItem Header="Awoken Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportPbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.AwokenSkill}"/>
                        <MenuItem Header="Demo (Cutscene)" Command="{Binding ElementName=Window, Path=EepkView.ImportPbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Demo}"/>
                        <Separator/>
                        <MenuItem Header="From Cached Files" ItemsSource="{Binding cacheManager.CachedFiles, ElementName=eepkEditor}" Click="PBIND_ImportAsset_MenuItem_FromCachedFiles_Click">
                            <MenuItem.ItemContainerStyle>
                                <Style>
                                    <Setter Property="MenuItem.Header" Value="{Binding DisplayName}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="TBIND">
                        <MenuItem Header="Load External EEPK" Command="{Binding ElementName=Window, Path=EepkView.ImportAssetsFromExternalFileCommand}" CommandParameter="{x:Static eepk:AssetType.TBIND}"/>
                        <Separator/>
                        <MenuItem Header="CMN" Command="{Binding ElementName=Window, Path=EepkView.ImportTbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.CMN}"/>
                        <MenuItem Header="Character" Command="{Binding ElementName=Window, Path=EepkView.ImportTbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Character}"/>
                        <MenuItem Header="Super Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportTbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.SuperSkill}"/>
                        <MenuItem Header="Ultimate Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportTbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.UltimateSkill}"/>
                        <MenuItem Header="Evasive Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportTbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.EvasiveSkill}"/>
                        <MenuItem Header="Blast Skill/Type" Command="{Binding ElementName=Window, Path=EepkView.ImportTbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.BlastSkill}"/>
                        <MenuItem Header="Awoken Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportTbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.AwokenSkill}"/>
                        <MenuItem Header="Demo (Cutscene)" Command="{Binding ElementName=Window, Path=EepkView.ImportTbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Demo}"/>
                        <Separator/>
                        <MenuItem Header="From Cached Files" ItemsSource="{Binding cacheManager.CachedFiles, ElementName=eepkEditor}" Click="TBIND_ImportAsset_MenuItem_FromCachedFiles_Click">
                            <MenuItem.ItemContainerStyle>
                                <Style>
                                    <Setter Property="MenuItem.Header" Value="{Binding DisplayName}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="CBIND">
                        <MenuItem Header="Load External EEPK" Command="{Binding ElementName=Window, Path=EepkView.ImportAssetsFromExternalFileCommand}" CommandParameter="{x:Static eepk:AssetType.CBIND}"/>
                        <MenuItem Header="Load External ECF" Command="{Binding ElementName=Window, Path=EepkView.CbindImportExternalEcfCommand}"/>
                        <Separator/>
                        <MenuItem Header="CMN" Command="{Binding ElementName=Window, Path=EepkView.ImportCbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.CMN}"/>
                        <MenuItem Header="Character" Command="{Binding ElementName=Window, Path=EepkView.ImportCbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Character}"/>
                        <MenuItem Header="Super Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportCbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.SuperSkill}"/>
                        <MenuItem Header="Ultimate Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportCbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.UltimateSkill}"/>
                        <MenuItem Header="Evasive Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportCbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.EvasiveSkill}"/>
                        <MenuItem Header="Blast Skill/Type" Command="{Binding ElementName=Window, Path=EepkView.ImportCbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.BlastSkill}"/>
                        <MenuItem Header="Awoken Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportCbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.AwokenSkill}"/>
                        <MenuItem Header="Demo (Cutscene)" Command="{Binding ElementName=Window, Path=EepkView.ImportCbindAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Demo}"/>
                        <Separator/>
                        <MenuItem Header="From Cached Files" ItemsSource="{Binding cacheManager.CachedFiles, ElementName=eepkEditor}" MouseMove="MenuItem_MouseMove" Click="CBIND_ImportAsset_MenuItem_FromCachedFiles_Click">
                            <MenuItem.ItemContainerStyle>
                                <Style>
                                    <Setter Property="MenuItem.Header" Value="{Binding DisplayName}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="EMO">
                        <MenuItem Header="Load External EEPK" Command="{Binding ElementName=Window, Path=EepkView.ImportAssetsFromExternalFileCommand}" CommandParameter="{x:Static eepk:AssetType.EMO}"/>
                        <MenuItem Header="Load External Files" Command="{Binding ElementName=Window, Path=EepkView.EmoImportExternalFilesCommand}"/>
                        <Separator/>
                        <MenuItem Header="CMN" Command="{Binding ElementName=Window, Path=EepkView.ImportEmoAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.CMN}"/>
                        <MenuItem Header="Character" Command="{Binding ElementName=Window, Path=EepkView.ImportEmoAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Character}"/>
                        <MenuItem Header="Super Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportEmoAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.SuperSkill}"/>
                        <MenuItem Header="Ultimate Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportEmoAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.UltimateSkill}"/>
                        <MenuItem Header="Evasive Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportEmoAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.EvasiveSkill}"/>
                        <MenuItem Header="Blast Skill/Type" Command="{Binding ElementName=Window, Path=EepkView.ImportEmoAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.BlastSkill}"/>
                        <MenuItem Header="Awoken Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportEmoAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.AwokenSkill}"/>
                        <MenuItem Header="Demo (Cutscene)" Command="{Binding ElementName=Window, Path=EepkView.ImportEmoAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Demo}"/>
                        <Separator/>
                        <MenuItem Header="From Cached Files" ItemsSource="{Binding cacheManager.CachedFiles, ElementName=eepkEditor}" MouseMove="MenuItem_MouseMove" Click="EMO_ImportAsset_MenuItem_FromCachedFiles_Click">
                            <MenuItem.ItemContainerStyle>
                                <Style>
                                    <Setter Property="MenuItem.Header" Value="{Binding DisplayName}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="LIGHT">
                        <MenuItem Header="Load External EEPK" Command="{Binding ElementName=Window, Path=EepkView.ImportAssetsFromExternalFileCommand}" CommandParameter="{x:Static eepk:AssetType.LIGHT}"/>
                        <MenuItem Header="Load External LIGHT" Command="{Binding ElementName=Window, Path=EepkView.LightImportExternalCommand}"/>
                        <Separator/>
                        <MenuItem Header="CMN" Command="{Binding ElementName=Window, Path=EepkView.ImportLightAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.CMN}"/>
                        <MenuItem Header="Character" Command="{Binding ElementName=Window, Path=EepkView.ImportLightAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Character}"/>
                        <MenuItem Header="Super Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportLightAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.SuperSkill}"/>
                        <MenuItem Header="Ultimate Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportLightAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.UltimateSkill}"/>
                        <MenuItem Header="Evasive Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportLightAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.EvasiveSkill}"/>
                        <MenuItem Header="Blast Skill/Type" Command="{Binding ElementName=Window, Path=EepkView.ImportLightAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.BlastSkill}"/>
                        <MenuItem Header="Awoken Skill" Command="{Binding ElementName=Window, Path=EepkView.ImportLightAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.AwokenSkill}"/>
                        <MenuItem Header="Demo (Cutscene)" Command="{Binding ElementName=Window, Path=EepkView.ImportLightAssetsFromGameCommand}" CommandParameter="{x:Static forms:EntitySelector+EntityType.Demo}"/>
                        <Separator/>
                        <MenuItem Header="From Cached Files" ItemsSource="{Binding cacheManager.CachedFiles, ElementName=eepkEditor}" MouseMove="MenuItem_MouseMove" Click="LIGHT_ImportAsset_MenuItem_FromCachedFiles_Click">
                            <MenuItem.ItemContainerStyle>
                                <Style>
                                    <Setter Property="MenuItem.Header" Value="{Binding DisplayName}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </MenuItem>
                </MenuItem>
            </MenuItem>
            <MenuItem Header='Tool'>
                <MenuItem Header="Associate EEPK Extension" Command="{Binding ElementName=Window, Path=ToolMenu_AssociateEepkExtCommand}"/>
                <MenuItem Header="Associate VFXPACKAGE Extension" Command="{Binding ElementName=Window, Path=ToolMenu_AssociateVfxExtCommand}"/>
                <Separator/>
                <MenuItem Header="Export Effects (VfxPackage)" Command="{Binding ElementName=Window, Path=ToolMenu_ExportEffectsCommand}"/>
                <Separator/>
                <MenuItem Header="Hue Adjustment" Command="{Binding ElementName=Window, Path=EepkView.ToolMenu_HueAdjustCommand}"/>
                <MenuItem Header="Hue Set" Command="{Binding ElementName=Window, Path=EepkView.ToolMenu_HueSetCommand}"/>
                <Separator/>
                <MenuItem Header="Optimize Textures" Command="{Binding ElementName=Window, Path=EepkView.ToolMenu_CreateSuperTextureCommand}"/>
                <MenuItem Header="Clean All" Command="{Binding ElementName=Window, Path=EepkView.ToolMenu_CleanAllCommand}"/>
            </MenuItem>
            <MenuItem x:Name="nameListMenuMain" Header="Name Lists" IsEnabled="{Binding ElementName=Window, Path=IsFileLoaded}">

                <MenuItem Header="Save Name List" Click="NameList_Save_Click"/>
                <MenuItem Header="Clear Name List" Click="NameList_Clear_Click"/>
                <MenuItem x:Name="nameListMenu" Header="Apply..." ItemsSource="{Binding ElementName=Window, Path=nameListManager.LoadedNameLists}" Click="NameList_Item_Click">
                    <MenuItem.ItemContainerStyle>
                        <Style>
                            <Setter Property="MenuItem.Header" Value="{Binding DisplayName}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>

            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Check For Updates" Command="{Binding ElementName=Window, Path=HelpMenu_CheckForUpdatesCommand}"/>
                <MenuItem Header="GitHub" Command="{Binding ElementName=Window, Path=HelpMenu_OpenGitHubCommand}"/>
                <Separator/>
                <MenuItem Header="Shortcut keys" Command="{Binding ElementName=Window, Path=HelpMenu_ShortcutKeysCommand}"/>
                <MenuItem Header="About" Command="{Binding ElementName=Window, Path=HelpMenu_AboutCommand}"/>
            </MenuItem>


        </Menu>
        <view:EepkEditor x:Name="eepkEditor" Grid.Row="1" effectContainerFile="{Binding ElementName=Window, Path=EepkFile}" IsEnabled="{Binding ElementName=Window, Path=IsFileLoaded}"/>

        <Label Grid.Row="1" Content="{Binding Path=EepkFile.DisplayName, Mode=OneWay, ElementName=Window}" IsEnabled="{Binding IsFileLoaded}" HorizontalContentAlignment="Right" Margin="10,0,11.333,-0.333" VerticalAlignment="Bottom" Height="26" Grid.RowSpan="2">
            <Label.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Full Path" Click="FilePath_MenuItem_CopyFullPath_Click"/>
                    <MenuItem Header="Copy Directory" Click="FilePath_MenuItem_CopyDirectory_Click"/>
                </ContextMenu>
            </Label.ContextMenu>
        </Label>

    </Grid>
</mvvm:AutoObservableWindow>