<mvvm:AutoObservableWindow x:Class="EEPK_Organiser.Forms.EffectSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EEPK_Organiser.Forms"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:mvvm="clr-namespace:LB_Common.Mvvm;assembly=LB_Common"
        mc:Ignorable="d"
        Title="Effect Selector" Height="465.127" Width="430" ShowInTaskbar="True" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" TitleCharacterCasing="Normal" Name="Window">
    <Grid>
        <DataGrid x:Name="effectDataGrid" ItemsSource="{Binding ElementName=Window, Path=Effects}" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True" SelectionMode="Extended" RowDetailsVisibilityMode="Collapsed" HorizontalAlignment="Left" Height="321" Margin="10,10,0,0" VerticalAlignment="Top" Width="400" CanUserResizeRows="False" CanUserAddRows="False" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Selected">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Effect ID" Width="0.8*" Binding="{Binding Effect.IndexNum}" IsReadOnly="True"/>

                <DataGridTemplateColumn Header="New ID" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NewEffectID}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Controls:NumericUpDown Value="{Binding NewEffectID}" Minimum="0" Maximum="65535"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Increase ID" Click="ContextMenu_IncreaseID_Click"/>
                    <MenuItem Header="Decrease ID" Click="ContextMenu_DecreaseID_Click"/>
                    <MenuItem Header="Select" Click="ContextMenu_Select_Click"/>
                    <MenuItem Header="Unselect" Click="ContextMenu_Unselect_Click"/>
                    <MenuItem Header="Select All" Click="SelectAll_Click"/>
                    <MenuItem Header="Unselect All" Click="UnselectAll_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.InputBindings>
                <KeyBinding Key="S" Command="{Binding ToggleSelectionCommand}"/>
            </DataGrid.InputBindings>
        </DataGrid>
        <Button Click="Done_Click" Content="Done" HorizontalAlignment="Left" Margin="173,400,0,0" VerticalAlignment="Top" Width="75"/>
        <Controls:NumericUpDown VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="23" Margin="61,351,0,0" Value="{Binding ElementName=Window, Path=IdIncreaseValue, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" VerticalAlignment="Top" Width="150"/>
        <Button Click="IdIncreaseValueButton_Click" Content="Increase ID" HorizontalAlignment="Left" Margin="232,350,0,0" VerticalAlignment="Top" Width="75"/>
        <Button Click="IdDecreaseValueButton_Click" Content="Decrease ID" HorizontalAlignment="Left" Margin="312,350,0,0" VerticalAlignment="Top" Width="75"/>
    </Grid>
</mvvm:AutoObservableWindow>
